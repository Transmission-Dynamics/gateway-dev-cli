#!/bin/sh
[ ! -f "$GW_TEST_DIR/mongo-fails" ] || { echo 'connect failed' >&2; exit 1; }
[ -f "$GW_TEST_DIR/tasks" ] || exit 0
sort "$GW_TEST_DIR/tasks" | awk -F '\t' '
  { commands[$1] = ($1 in commands) ? commands[$1] ", " $2 : $2 }
  END { for (uuid in commands) print uuid "\t" commands[uuid] }
'
