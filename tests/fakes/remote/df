#!/bin/sh
for mount; do :; done
echo 'Filesystem 1024-blocks Used Available Capacity Mounted on'
case $mount in
  /)
    total=${GW_TEST_ROOT_TOTAL_KB:-5000000} used=${GW_TEST_ROOT_USED_KB:-1600000}
    echo "/dev/root $total $used $((total - used)) $((used * 100 / total))% /"
    ;;
  *)
    total=${GW_TEST_SD_TOTAL_KB:-30000000} used=${GW_TEST_SD_USED_KB:-900000}
    echo "/dev/mmcblk1p1 $total $used $((total - used)) $((used * 100 / total))% $mount"
    ;;
esac
